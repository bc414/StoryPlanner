<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>StoryPlanner.TurnItemizer</RootNamespace>
        <!-- The turn itemizer (2026-09-17): cuts dialogue into exchanges. Over the lineage layers
             (Gemini web, AI Studio, NotebookLM) and the conversations corpus, one item per user
             turn with the model turn before it (`user-turns`), or per model turn whose last
             paragraph holds a question with the user turn after it (`question-endings`). Over
             code-sessions, one item per user turn of the chosen kinds with the assistant's turn
             before it (`session-decisions`). A turn is a run of consecutive records of one role.
             Read-only throughout; an authored config names the layers and the databases. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
        <!-- The pin Core carries: 10.0.7 resolves SQLitePCLRaw 2.1.11, whose bundled SQLite has an advisory. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StoryPlanner.BatchFiles\StoryPlanner.BatchFiles.csproj" />
    </ItemGroup>

</Project>
