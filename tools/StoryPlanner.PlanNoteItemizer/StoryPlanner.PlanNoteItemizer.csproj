<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>StoryPlanner.PlanNoteItemizer</RootNamespace>
        <!-- The working-plan note itemizer (2026-09-17): cuts the v2 .storyplan's notes into one
             item per note, or one per owner, as an authored config selects them — theme-tagged,
             tracked, in named tracks, or all — with the owner's other notes or named tracks beside
             a note as context. Every item says what the note is: its owner, its track with the
             track type's cognitive mode and display question, its theme and its world date.
             Flagged notes never enter an item, as selection or as context (CORPORA.md,
             working-plan). Read raw with Mode=ReadOnly; Core supplies the track types' modes and
             the world-date notation, so the item says what the app says. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\StoryPlanner.Core\StoryPlanner.Core.csproj" />
        <ProjectReference Include="..\StoryPlanner.BatchFiles\StoryPlanner.BatchFiles.csproj" />
    </ItemGroup>

</Project>
