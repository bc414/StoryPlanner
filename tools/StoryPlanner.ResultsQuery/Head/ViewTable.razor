@* One view's table: the caption, the column heads, the rows as the view produced them. The
   list view's rows carry every part of a line; a count view's carry a term and its counts.
   A cell under an `item` or `cites` head opens that item when OnItem is set.
   Parameter-driven, no services. *@
<p class="caption">@Caption</p>
@if (Rows.Count == 0)
{
    <p class="muted">nothing</p>
}
else
{
    <table class="view">
        <thead><tr>@foreach (var c in Columns) { <th>@c</th> }</tr></thead>
        <tbody>
        @foreach (var r in Rows)
        {
            <tr>
                @for (var i = 0; i < r.Count; i++)
                {
                    var cell = r[i];
                    if (OnItem.HasDelegate && i < Columns.Count && ItemHeads.Contains(Columns[i]))
                    {
                        <td><button class="item-link" @onclick="() => OnItem.InvokeAsync(cell)">@cell</button></td>
                    }
                    else
                    {
                        <td>@cell</td>
                    }
                }
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private static readonly HashSet<string> ItemHeads = new(StringComparer.Ordinal) { "item", "cites" };

    [Parameter] public string Caption { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Columns { get; set; } = [];
    [Parameter] public IReadOnlyList<IReadOnlyList<string>> Rows { get; set; } = [];
    [Parameter] public EventCallback<string> OnItem { get; set; }
}
