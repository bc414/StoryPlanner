@page "/map"
@inject RunnerHost Host

@* The order of a batch in its study: the v3-buildout skill's generated map.md, rendered. Nothing
   here is authored. Read on every visit, so a `render` shows without a host restart. *@
<div class="protocol">
    @if (text is null)
    {
        <h1>Process map</h1>
        <p class="err">No process map found. Looked for <code>mapPath</code> in <code>host.json</code>@(Host.Config.MapPath is null ? " (not set)" : $" ({Host.Config.MapPath})"), then @string.Join(", ", HostConfig.MapCandidates) under the repo root above @Host.WorkingDir.</p>
    }
    else
    {
        <p class="muted">Rendering of <code>@path</code>, generated by <code>process-docs/StoryPlanner.DocIntegrity</code>. The runner makes calls; what precedes and follows a batch is read from these tables. Diagrams are mermaid source, folded.</p>
        @MarkdownView.RenderWithFoldedDiagrams(text)
    }
</div>

@code {
    private string? text; private string path = "";
    protected override void OnInitialized()
    {
        var resolved = HostConfig.ResolveMapPath(Host.Config.MapPath, Host.WorkingDir);
        path = resolved ?? "";
        text = resolved is not null ? File.ReadAllText(resolved) : null;
    }
}
