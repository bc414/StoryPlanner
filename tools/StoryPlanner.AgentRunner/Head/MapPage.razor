@page "/protocol"
@inject RunnerHost Host

@* The order of a run: the v3-buildout skill's generated map.md, rendered. Nothing here is
   authored — fanout/PROTOCOL.md, the hand-kept page this route served from 2026-09-03,
   retired on 2026-09-05. Read on every visit, so a `render` shows without a host restart. *@
<div class="protocol">
    @if (text is null)
    {
        <h1>Process map</h1>
        <p class="err">No process map found. Looked for <code>mapPath</code> in <code>host.json</code>@(Host.Config.MapPath is null ? " (not set)" : $" ({Host.Config.MapPath})"), then @string.Join(", ", HostConfig.MapCandidates) under the repo root above @Host.FanoutRoot.</p>
    }
    else
    {
        <p class="muted">Rendering of <code>@path</code>, generated by <code>process-docs/StoryPlanner.DocIntegrity</code>. The runner is an instrument; what precedes and follows a batch is read from these tables. Diagrams are mermaid source, folded.</p>
        @MarkdownView.RenderWithFoldedDiagrams(text)
    }
</div>

@code {
    private string? text; private string path = "";
    protected override void OnInitialized()
    {
        var resolved = HostConfig.ResolveMapPath(Host.Config.MapPath, Host.FanoutRoot);
        path = resolved ?? "";
        text = resolved is not null ? File.ReadAllText(resolved) : null;
    }
}
