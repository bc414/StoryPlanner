@* Leaf: harness control for one live execution — how it runs, never what a call is. *@
<div class="controls">
    @if (Batch.Scheduled)
    {
        <span>scheduled for @(DateTimeOffset.TryParse(Batch.NotBeforeUtc, out var t) ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : Batch.NotBeforeUtc)</span>
        <button class="danger" @onclick='() => OnAction.InvokeAsync("unschedule")'>unschedule</button>
    }
    else if (!Batch.Live)
    {
        <span class="muted">@(Batch.Completed ? "executed" : "not executing") — execute-batch from the CLI to call what is pending</span>
    }
    else
    {
        @if (Batch.Paused) { <button @onclick='() => OnAction.InvokeAsync("resume")'>resume</button> }
        else { <button @onclick='() => OnAction.InvokeAsync("pause")' disabled="@Batch.StopRequested">pause</button> }
        <button @onclick='() => OnAction.InvokeAsync("stop")' disabled="@Batch.StopRequested">stop after in-flight</button>
        <button class="danger" @onclick='() => OnAction.InvokeAsync("cancel")' disabled="@(!CanCancel)">cancel selected</button>
        <span>@Batch.InFlight in flight, @Batch.Pending pending</span>
        @if (Batch.HoldReason is { } h) { <span class="hold">held: @h</span> }
    }
</div>

@code {
    [Parameter, EditorRequired] public BatchSnapshot Batch { get; set; } = default!;
    [Parameter] public string? SelectedItem { get; set; }
    [Parameter] public EventCallback<string> OnAction { get; set; }
    private bool CanCancel => SelectedItem is not null && Batch.Items.Any(i => i.Item == SelectedItem && i.State == "Running");
}
