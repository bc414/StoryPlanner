@page "/batches/{*BatchId}"
@implements IDisposable
@inject RunnerHost Host

@if (batch is null)
{
    <h1>@BatchId</h1>
    <p class="err">No such batch beneath @Host.WorkingDir.</p>
}
else
{
    <h1>@batch.Name <span class="muted">— @batch.Study</span></h1>
    @if (batch.Error is { } err) { <p class="err">@err</p> }
    <p class="muted">kind @(batch.Kind ?? "—") · model @(batch.Model ?? "?")@(batch.Effort is null ? "" : $" ({batch.Effort})") · directions @(batch.Directions ?? "?") · <code>@batch.Dir</code></p>
    <StageStrip S="batch.Stages" />

    <HarnessControls Batch="batch" SelectedItem="@selected" OnAction="Act" />
    <p class="muted">@batch.Succeeded answered, @batch.Failed failed, @batch.Pending pending — api-equiv $@batch.CostUsd.ToString("F2")</p>

    <div class="split">
        <div><CallTable Items="batch.Items" SelectedItem="@selected" OnSelect="Select" /></div>
        <div><StreamPane Events="events" Title="@streamTitle" /></div>
    </div>
}

@code {
    [Parameter] public string? BatchId { get; set; }
    private BatchSnapshot? batch;
    private string? selected;
    private IReadOnlyList<StreamEvent> events = [];
    private string? streamTitle;
    private bool streamDirty;
    private Timer? timer;

    protected override void OnParametersSet()
    {
        batch = BatchId is null ? null : Host.Batch(BatchId);
        selected = null; events = []; streamTitle = null;
    }

    protected override void OnInitialized()
    {
        Host.Changed += OnChanged;
        Host.StreamAdvanced += OnStream;
        // Stream lines can arrive hundreds of times a second; re-read the tail at most twice a second.
        timer = new Timer(_ => { if (streamDirty) { streamDirty = false; _ = InvokeAsync(ReloadStream); } }, null, 500, 500);
    }

    private void OnChanged() => _ = InvokeAsync(() => { if (BatchId is not null) batch = Host.Batch(BatchId); StateHasChanged(); });
    private void OnStream(string batchId, string item, int call) { if (batchId == BatchId && item == selected) streamDirty = true; }

    private void Select(string item) { selected = item; ReloadStream(); }

    private void ReloadStream()
    {
        var i = batch?.Items.FirstOrDefault(x => x.Item == selected);
        if (i?.StreamPath is null) { events = []; streamTitle = selected is null ? null : $"{selected} — no call yet"; }
        else { events = StreamEvents.ReadTail(i.StreamPath, 400); streamTitle = $"{i.Item} — call {i.Calls}{(i.State == "Running" ? " (live)" : "")}"; }
        StateHasChanged();
    }

    private void Act(string action)
    {
        if (batch is null) return;
        switch (action)
        {
            case "pause": Host.Pause(batch.Id); break;
            case "resume": Host.Resume(batch.Id); break;
            case "stop": Host.Stop(batch.Id); break;
            case "cancel": if (selected is not null) Host.Cancel(batch.Id, selected); break;
            case "unschedule": Host.Unschedule(batch.Id); break;
        }
    }

    public void Dispose() { Host.Changed -= OnChanged; Host.StreamAdvanced -= OnStream; timer?.Dispose(); }
}
