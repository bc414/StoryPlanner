@* Leaf: which stages the batch folder shows evidence of. Detected, never judged. *@
<div class="stages">
    <span class="stage @(S.Defined ? "on" : "")">defined</span>
    <span class="stage @(S.Itemized ? "on" : "")">itemized</span>
    <span class="stage @(S.Piloted ? "on" : "")">piloted</span>
    <span class="stage @(S.Executed ? "on" : "")">executed</span>
    <span class="stage @(S.Tallied ? "on" : "")">tallied</span>
</div>

@code {
    [Parameter, EditorRequired] public BatchStages S { get; set; } = default!;
}
