@page "/"
@implements IDisposable
@inject RunnerHost Host

<h1>Runs</h1>
<RunList Runs="runs" />
<p class="muted">Enqueue from a terminal: <code>AgentRunner.exe fanout\&lt;work&gt;\&lt;run&gt;\jobs.json</code>. The order of a run is the <a href="/protocol">process map</a>; the rules of the instrument are the agent-runner skill.</p>

@code {
    private IReadOnlyList<RunSnapshot> runs = [];
    protected override void OnInitialized() { runs = Host.Runs(); Host.Changed += OnChanged; }
    private void OnChanged() => _ = InvokeAsync(() => { runs = Host.Runs(); StateHasChanged(); });
    public void Dispose() => Host.Changed -= OnChanged;
}
