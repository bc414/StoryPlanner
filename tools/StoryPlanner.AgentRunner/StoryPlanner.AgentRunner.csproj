<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>StoryPlanner.AgentRunner</RootNamespace>
        <!-- A console tool with verbs that also hosts its own head (Blazor Server on localhost);
             the Web SDK is what brings Kestrel and Razor components. One flat namespace: the
             Razor files set it in Head/_Imports.razor. -->
    </PropertyGroup>

    <ItemGroup>
        <!-- Same version StoryPlanner.Core carries; renders fanout/PROTOCOL.md and run.md. -->
        <PackageReference Include="Markdig" Version="1.1.2" />
    </ItemGroup>

</Project>
