<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>StoryPlanner.SourceTexts</RootNamespace>
    </PropertyGroup>

    <!-- Core is referenced for Microsoft.Data.Sqlite only. This tool deliberately never opens
         an AppDbContext: it reads the .storyplan spine through a read-only SQLite connection
         and writes solely to sources.db. -->
    <ItemGroup>
        <ProjectReference Include="..\..\StoryPlanner.Core\StoryPlanner.Core.csproj" />
    </ItemGroup>

</Project>
