<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>StoryPlanner.SurfacingItemizer</RootNamespace>
        <!-- The referee-batch itemizers of the evidence pipeline. Surfacing (d-2026-09-10-5, -6):
             claim cuts a verification's standing findings into one item per finding (the finding
             is the call's message); referee cuts the claiming results into one item per
             (finding, target) claim (the target's current statement and the finding, blind).
             Iterating (d-2026-09-11-2, -3): reverify cuts a hypothesis's current-wording evidence
             entries into one item each, holding the proposed wording and that entry's frozen
             finding, blind, for the gate's re-verification. Each writes a batch's index in the
             index schema's shape and the item bodies under items/, like every itemizer. -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\StoryPlanner.BatchFiles\StoryPlanner.BatchFiles.csproj" />
    </ItemGroup>

</Project>
