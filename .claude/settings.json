{
  "model": "claude-opus-5[1m]",
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet ef*)",
      "Bash(dotnet run*)",
      "Edit(.claude/**)",
      "mcp__storyplanner"
    ],
    "deny": [
      "Edit(.claude/skills/*/map.md)",
      "Write(.claude/skills/*/map.md)",
      "Edit(.claude/skills/*/state.md)",
      "Write(.claude/skills/*/state.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__storyplanner__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", ".claude/hooks/storyplanner-plan-mode-allow.ps1"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "process-docs/StoryPlanner.DocIntegrity/publish/StoryPlanner.DocIntegrity.exe",
            "args": ["hook"]
          }
        ]
      }
    ]
  }
}
