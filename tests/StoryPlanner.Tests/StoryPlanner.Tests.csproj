<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>StoryPlanner.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <!-- RazorComponents tier for the agent runner's head: leaf components rendered against a
             RunSnapshot — the same bUnit and conventions as TheCanalaveLibrary (BunitContext,
             parameter-driven leaves, no service fakes). -->
        <PackageReference Include="bunit" Version="2.7.2" />
    </ItemGroup>

    <!-- Mcp references Core transitively; both tiers live here because neither needs
         infrastructure beyond a temp SQLite file. See .claude/skills/testing/SKILL.md.
         The ingest projects are referenced so fixture tests write their sidecar dbs with the
         PRODUCTION Db classes (GeminiCorpus never got one — which is why it shipped untested;
         Lineage and CodeSessions do). -->
    <ItemGroup>
        <ProjectReference Include="..\..\tools\StoryPlanner.Mcp\StoryPlanner.Mcp.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.DataOps\StoryPlanner.DataOps.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.SourceTexts\StoryPlanner.SourceTexts.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.GeminiCorpus\StoryPlanner.GeminiCorpus.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.Lineage\StoryPlanner.Lineage.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.CodeSessions\StoryPlanner.CodeSessions.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.GDocHistory\StoryPlanner.GDocHistory.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.PocketReader\StoryPlanner.PocketReader.csproj" />
        <ProjectReference Include="..\..\tools\StoryPlanner.AgentRunner\StoryPlanner.AgentRunner.csproj" />
    </ItemGroup>

</Project>
