<UserControl x:Class="WindowedStoryPlanner.GlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=local:GlobalSearchViewModel}">

    <UserControl.Resources>
        <!-- A broad query can return well over a thousand note hits — grouping disables the
             ListBox's default virtualization, so VirtualizingPanel.IsVirtualizingWhenGrouping
             below is load-bearing, not decoration. -->
        <CollectionViewSource x:Key="GroupedResults" Source="{Binding Results}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="TypeLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Search subject/plot point/chapter/theme/source-material names and note content (flagged notes included)"
                       FontSize="13" Foreground="Gray" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20" Padding="5" Height="40"
                         VerticalContentAlignment="Center"
                         Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding TypeFilterOptions}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          FontSize="14" Height="40" VerticalContentAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="#777777" Margin="0,6,0,0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                 SelectedItem="{Binding SelectedResult}"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="Results_MouseDoubleClick">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" FontSize="14" Margin="0,10,0,4" Foreground="#2E86C1">
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SearchResultViewModel}">
                    <Border Margin="0,1" Padding="4,3" BorderThickness="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="#FFF7E6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StateGlyph}" FontSize="13" Width="18"
                                           Foreground="#CC7A00" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#777777"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Snippet}" FontSize="12" Foreground="#444444"
                                       TextWrapping="Wrap" Margin="18,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
