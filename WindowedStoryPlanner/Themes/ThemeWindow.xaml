<Window x:Class="WindowedStoryPlanner.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowedStoryPlanner"
        mc:Ignorable="d"
        Title="{Binding Theme.Name, StringFormat='Theme: {0}'}"
        Height="800" Width="700"
        d:DataContext="{d:DesignInstance Type=local:ThemeDetailViewModel}">

    <DockPanel Margin="12">

        <!-- ── Theme header ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Name" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Theme.Name, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18" FontWeight="Bold"
                     BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

            <TextBlock Text="Proposition" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
            <TextBox Text="{Binding Theme.Proposition, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     BorderThickness="0,0,0,1" Padding="0,0,0,4"/>
        </StackPanel>

        <!-- ── Tagged notes ── -->
        <local:CrossCutNoteListView/>

    </DockPanel>
</Window>
