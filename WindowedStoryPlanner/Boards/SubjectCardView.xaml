<UserControl x:Class="WindowedStoryPlanner.SubjectCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SubjectCardViewModel}">

    <!-- One subject on a board. Identical in a grid cell and in a tree node — the card does not
         know where it is, so a pattern learned in one view reads the same in the other.
         A chromeless Button rather than a click handler, so the card is keyboard-reachable. -->
    <Button Command="{Binding OpenCommand}" ToolTip="Open this subject"
            HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0" BorderThickness="0">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="Transparent" Padding="2,1" Margin="0,0,0,2">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="#F2F6FC"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>

            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,1,0,0">
                <ItemsControl.ItemsPanel>
                    <!-- One row of equal-width columns, NOT a WrapPanel. Cards stacked in the same
                         grid cell (or tree depth) share a width, so equal columns make slot n of
                         every card line up vertically — which is what lets a repeated value
                         pattern be read down a column at a glance. A WrapPanel sized each chip to
                         its text and the columns went ragged. -->
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- An unset property still gets a chip: omitting it would shift every
                             later slot, and slot position is how a chip says which property it
                             answers. -->
                        <Border CornerRadius="7" Padding="4,0" Margin="0,0,3,2"
                                Background="{Binding Fill}"
                                BorderBrush="#BBBBBB" BorderThickness="1"
                                ToolTip="{Binding Tooltip}">
                            <!-- Equal columns mean a long value name has to trim; the tooltip on
                                 the Border carries the full "Property: Value" either way. -->
                            <TextBlock Text="{Binding Label}" FontSize="9.5"
                                       Foreground="{Binding Ink}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Button>
</UserControl>
