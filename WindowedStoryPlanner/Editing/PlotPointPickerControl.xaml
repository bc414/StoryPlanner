<UserControl x:Class="WindowedStoryPlanner.PlotPointPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="220">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="8">
        <StackPanel Width="220">

            <!-- Combo pair -->
            <TextBlock Text="Chapter" FontSize="11"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ChapterCombo" Grid.Column="0"
                          ItemsSource="{Binding Chapters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="FullTitle"
                          SelectionChanged="ChapterCombo_SelectionChanged"/>
                <Button x:Name="ClearChapterButton" Grid.Column="1" Content="✕"
                        Width="18" Height="18" Padding="0" FontSize="9" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#888"
                        ToolTip="Clear — search across every chapter again"
                        Visibility="Collapsed" Click="ClearChapterButton_Click"/>
            </Grid>

            <TextBlock Text="Plot Point" FontSize="11"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Margin="0,0,0,2"/>
            <ComboBox x:Name="PlotPointCombo"
                      ItemsSource="{Binding FilteredPlotPoints, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      DisplayMemberPath="Title"
                      SelectionChanged="PlotPointCombo_SelectionChanged"
                      Margin="0,0,0,8"/>

            <Separator Margin="0,0,0,8"/>

            <!-- Search box -->
            <TextBlock Text="Search" FontSize="11"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Margin="0,0,0,2"/>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding SearchScopeHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Margin="0,0,0,2"/>

            <!-- Search results: visible only when search text is non-empty -->
            <ListBox x:Name="SearchResultsList"
                     ItemsSource="{Binding SearchResults, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     DisplayMemberPath="Title"
                     MaxHeight="160"
                     Visibility="{Binding HasSearchText, RelativeSource={RelativeSource AncestorType=UserControl},
                                  Converter={StaticResource BoolToVis}}"
                     SelectionChanged="SearchResultsList_SelectionChanged"/>
        </StackPanel>
    </Border>
</UserControl>