<UserControl x:Class="WindowedStoryPlanner.NoteTrackSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=local:NoteTrackSectionViewModel}"
             PreviewKeyDown="NoteTrackSectionView_PreviewKeyDown">

    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Insert-here strip shown above each note in the Unset section.
             Constant height so hovering never reflows the list; only opacity
             changes. Root's Background="Transparent" is load-bearing: a null
             background is not hit-testable, so IsMouseOver would never fire. -->
        <Style x:Key="InsertStripStyle" TargetType="Button">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Insert a new note here"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" Opacity="0">
                            <Rectangle Height="1" Fill="#7AA7D8" Margin="14,0,4,0"
                                       VerticalAlignment="Center"/>
                            <Border Width="14" Height="10" CornerRadius="2"
                                    Background="#7AA7D8" HorizontalAlignment="Left">
                                <TextBlock Text="+" Foreground="White" FontSize="9"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Confirmed: solid green border brush -->
        <SolidColorBrush x:Key="ConfirmedBorderBrush" Color="#34A853"/>

        <!-- Unset: light gray border brush -->
        <SolidColorBrush x:Key="UnsetBorderBrush" Color="#CCCCCC"/>

        <!-- Flagged: solid red/pink border brush -->
        <SolidColorBrush x:Key="FlaggedBorderBrush" Color="#E05A4E"/>

        <!-- Background tints per section state -->
        <SolidColorBrush x:Key="ConfirmedBackgroundBrush" Color="#F2FBF5"/>
        <SolidColorBrush x:Key="UnsetBackgroundBrush"     Color="#F8F8F8"/>
        <SolidColorBrush x:Key="FlaggedBackgroundBrush"   Color="#FDF0EE"/>

        <!-- Header label color per state -->
        <SolidColorBrush x:Key="ConfirmedHeaderBrush" Color="#1E7E34"/>
        <SolidColorBrush x:Key="UnsetHeaderBrush"     Color="#888888"/>
        <SolidColorBrush x:Key="FlaggedHeaderBrush"   Color="#9C3B2E"/>

    </UserControl.Resources>

    <Border CornerRadius="5"
            BorderThickness="2"
            Margin="4"
            Padding="0">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush"  Value="{StaticResource UnsetBorderBrush}"/>
                <Setter Property="Background"   Value="{StaticResource UnsetBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SectionHeader}" Value="Confirmed">
                        <Setter Property="BorderBrush" Value="{StaticResource ConfirmedBorderBrush}"/>
                        <Setter Property="Background"  Value="{StaticResource ConfirmedBackgroundBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SectionHeader}" Value="Flagged">
                        <Setter Property="BorderBrush" Value="{StaticResource FlaggedBorderBrush}"/>
                        <Setter Property="Background"  Value="{StaticResource FlaggedBackgroundBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>

            <!-- ── Section header ── -->
            <Border DockPanel.Dock="Top"
                    CornerRadius="3,3,0,0"
                    Padding="8,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEEEEE"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SectionHeader}" Value="Confirmed">
                                <Setter Property="Background" Value="#C8EDCC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SectionHeader}" Value="Flagged">
                                <Setter Property="Background" Value="#F5E6E4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding SectionHeader}"
                           FontWeight="SemiBold"
                           FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource UnsetHeaderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SectionHeader}" Value="Confirmed">
                                    <Setter Property="Foreground" Value="{StaticResource ConfirmedHeaderBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SectionHeader}" Value="Flagged">
                                    <Setter Property="Foreground" Value="{StaticResource FlaggedHeaderBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- ── Note list ── -->
            <!-- ScrollPassthroughBehavior lets wheel events bypass the ListBox's internal  -->
            <!-- ScrollViewer and bubble up to NoteTrackView's ScrollViewer instead.        -->
            <!-- IsDragSource/IsDropTarget are disabled when the section is readonly.       -->
            <!-- MinHeight ensures the Unset section has a usable drop target on empty      -->
            <!-- tracks even when no notes are present.                                     -->
            <ListBox x:Name="NotesList"
                     DockPanel.Dock="Bottom"
                     ItemsSource="{Binding SectionNotes}"
                     SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                     MinHeight="{Binding MinDropHeight}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     local:ScrollPassthroughBehavior.Enabled="True"
                     dd:DragDrop.IsDropTarget="True"
                     dd:DragDrop.DropHandler="{Binding}"
                     dd:DragDrop.IsDragSource="{Binding IsReadOnly,
                                               Converter={StaticResource InverseBoolConverter}}"
                     dd:DragDrop.UseDefaultDragAdorner="True"
                     dd:DragDrop.UseDefaultEffectDataTemplate="True">

                <ListBox.InputBindings>
                    <KeyBinding Key="Up"   Modifiers="Alt"  Command="{Binding MoveNoteUpCommand}"/>
                    <KeyBinding Key="Down" Modifiers="Alt"  Command="{Binding MoveNoteDownCommand}"/>
                    <KeyBinding Key="Up"   Modifiers="Ctrl" Command="{Binding PromoteNoteCommand}"/>
                    <KeyBinding Key="Down" Modifiers="Ctrl" Command="{Binding DemoteNoteCommand}"/>
                </ListBox.InputBindings>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown"
                                     Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Insert-here strip: reveals on hover, inserts a new
                                             note above this one. Only the Unset section of an
                                             editable track shows it (SupportsInsert). Not
                                             focusable — an invisible tab stop per note would
                                             wreck keyboard navigation. Sits outside the Border
                                             below so the note's hover/selection tint never
                                             covers it. -->
                                        <Button Grid.Row="0"
                                                Style="{StaticResource InsertStripStyle}"
                                                Focusable="False"
                                                Command="{Binding DataContext.InsertNoteBeforeCommand,
                                                          RelativeSource={RelativeSource AncestorType=local:NoteTrackSectionView}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.SupportsInsert,
                                                             RelativeSource={RelativeSource AncestorType=local:NoteTrackSectionView},
                                                             Converter={StaticResource BoolToVisibility}}"/>

                                        <Border Grid.Row="1"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <ContentPresenter/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18000000"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#CCE8FF"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected"  Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#99CAEE"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:NoteView/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </DockPanel>
    </Border>
</UserControl>
