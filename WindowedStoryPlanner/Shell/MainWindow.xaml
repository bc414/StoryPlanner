<Window x:Class="WindowedStoryPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowedStoryPlanner"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        Title="Mission Control" Height="900" Width="1200"
        WindowStartupLocation="CenterScreen" d:DataContext="{d:DesignInstance Type=local:ViewModelLocator}" WindowState="Maximized">
    <Window.Resources>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">

        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Height" Value="60" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </TabControl.Resources>

        <TabItem Header="File Management">
            <local:FileManagerTab DataContext="{Binding FileManager}"/>
        </TabItem>

        <TabItem Header="Stories">
            <local:StoryLibrary DataContext="{Binding Stories}"/>
        </TabItem>

        <TabItem Header="Chapters">
            <local:ChapterLibrary DataContext="{Binding Chapters}"/>
        </TabItem>

        <TabItem Header="Unassigned Plot Points" DataContext="{Binding FloatingPlotPoints}">
            <StackPanel Margin="20" MaxWidth="400">
                <TextBlock Text="Unassigned Plot Points"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"
                           Text="Plot points not yet assigned to a chapter. Open the window to edit, reorder, or drag them into a chapter."/>
                <Button Content="Open Unassigned Plot Points Window"
                        Height="36" FontSize="14" HorizontalAlignment="Left" Padding="12,0"
                        Command="{Binding OpenWindowCommand}"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Subjects">
            <local:SubjectLibrary DataContext="{Binding Subjects}"/>
        </TabItem>
        <!-- Inserted AFTER Subjects (index 4) on purpose: App.xaml.cs sets SelectedTabIndex = 4
             to land on Subjects after a file open — a tab inserted at or before index 4 would
             silently shift that. Keep Timeline at index 5+. -->
        <TabItem Header="Timeline">
            <local:TimelineView DataContext="{Binding Timeline}"/>
        </TabItem>
        <TabItem Header="Themes">
            <local:ThemeLibrary DataContext="{Binding Themes}"/>
        </TabItem>
        <TabItem Header="Definitions">
            <local:DefinitionsEditorControl DataContext="{Binding Definitions}"/>
        </TabItem>

        <!-- Read-only reports. Like Timeline above, these must stay at index 5+ so
             App.xaml.cs's SelectedTabIndex = 4 still lands on Subjects. -->
        <TabItem Header="Progress">
            <local:ProgressView DataContext="{Binding Progress}"/>
        </TabItem>
        <TabItem Header="Property Gaps">
            <local:PropertyGapsView DataContext="{Binding PropertyGaps}"/>
        </TabItem>

        <TabItem Header="Global Search">
            <local:GlobalSearchView DataContext="{Binding GlobalSearch}"/>
        </TabItem>

        <TabItem Header="Sources">
            <local:SourceMaterialLibrary DataContext="{Binding SourceMaterials}"/>
        </TabItem>

        <TabItem Header="Conversations">
            <local:ConversationLibrary DataContext="{Binding ConversationLibrary}"/>
        </TabItem>

        <TabItem Header="Export">
            <local:ExportView DataContext="{Binding Export}"/>
        </TabItem>

    </TabControl>
</Window>
