<Window x:Class="WindowedStoryPlanner.PovCharactersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WindowedStoryPlanner"
        mc:Ignorable="d"
        Title="POV Characters"
        Height="520" Width="420"
        d:DataContext="{d:DesignInstance Type=local:PovCharactersViewModel}">
    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top"
                   Text="Subjects flagged here are the candidates offered by a plot point's POV Character picker. Assignment is authorial — never inferred from links or note counts."
                   TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Add a POV character" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
            <local:SubjectPickerControl x:Name="SubjectPicker" Registry="{Binding Registry}"
                                         HorizontalAlignment="Left"/>
        </StackPanel>

        <Separator DockPanel.Dock="Top" Margin="0,0,0,10"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding PovCharacters.Count, StringFormat='{}{0} POV character(s)'}"
                   FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PovCharacters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SubjectViewModel}">
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Remove" Padding="6,2"
                                        Command="{Binding DataContext.RemoveCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
