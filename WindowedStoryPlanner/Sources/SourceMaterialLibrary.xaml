<UserControl x:Class="WindowedStoryPlanner.SourceMaterialLibrary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:SourceMaterialLibraryViewModel}">

    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="Button" x:Key="AddButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="Button" x:Key="DeleteButton">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#CC0000"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CC0000"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTip" Value="Delete source material"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Source Material Library" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
            <Button Content="+ Add Source Material"
                    Style="{StaticResource AddButton}"
                    Command="{Binding AddSourceMaterialCommand}"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Search ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Search: " VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="240" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Works DataGrid — select a row to see its coverage below ── -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredSourceMaterials}"
                  SelectedItem="{Binding SelectedSourceMaterial, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">
            <DataGrid.Columns>

                <!-- Id (read-only) -->
                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id}"
                                    IsReadOnly="True"
                                    Width="40"/>

                <!-- Name (editable) -->
                <DataGridTemplateColumn Header="Name" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Padding="3"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Description (editable) -->
                <DataGridTemplateColumn Header="Description" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                       Margin="4,0" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Padding="3" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Open source material window -->
                <DataGridTemplateColumn Header="" Width="80" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open"
                                    Padding="6,2"
                                    ToolTip="Open source material detail window"
                                    Command="{Binding DataContext.OpenSourceMaterialWindowCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Delete -->
                <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DeleteButton}"
                                    Command="{Binding DataContext.DeleteSourceMaterialCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Coverage toolbar: which Work's Parts, the untouched filter, quick actions ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0,0,0,0">
                <Run Text="Coverage"/>
                <Run Text="{Binding SelectedSourceMaterial.Name, StringFormat=' — {0}', FallbackValue=' — select a source above'}"/>
            </TextBlock>
            <CheckBox Content="Show only untouched" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding ShowOnlyUntouched}"
                      ToolTip="Never reviewed AND never cited — the rewatch/reread queue. A Part you reviewed and found nothing in is excluded even at 0 notes."/>
            <Button Content="+ Add Part" Style="{StaticResource AddButton}" Margin="12,0,0,0"
                    Command="{Binding AddPartCommand}"
                    Visibility="{Binding SelectedSourceMaterial, Converter={StaticResource NullToVis}}"/>
            <Button Content="Refresh Coverage" Padding="10,4" Margin="6,0,0,0"
                    Command="{Binding RefreshCoverageCommand}"
                    ToolTip="Note counts aren't live — refresh after citing a Part from a note editor elsewhere."/>
            <Button Content="Notes without a citation" Padding="10,4" Margin="6,0,0,0"
                    Command="{Binding OpenNotesWithoutCitationCommand}"
                    ToolTip="The note side of this grid: every note on a track that supports source material but carries no citation."/>
        </StackPanel>

        <!-- ── Parts DataGrid — the negative-space view ── -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding FilteredParts}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- The negative-space 2x2 (CLAUDE.md). ReviewState and citation count are
                             orthogonal, so each quadrant reads as its own state:
                               untouched      (not reviewed, uncited) — plain white, the baseline
                               cited          (not reviewed, cited)   — warm blue
                               confirmed empty(reviewed,     uncited) — beige: checked, nothing there
                               mined          (reviewed,     cited)   — green
                             No quadrant is ranked above another; these are labels, not a score. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsReviewed}" Value="True"/>
                                <Condition Binding="{Binding HasCitations}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#E6F4EA"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsReviewed}" Value="False"/>
                                <Condition Binding="{Binding HasCitations}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#E8F0FE"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsReviewed}" Value="True"/>
                                <Condition Binding="{Binding HasCitations}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#FFF7E6"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>

                <!-- Code (editable) -->
                <DataGridTemplateColumn Header="Code" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Code}" VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Padding="3"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Name (editable) -->
                <DataGridTemplateColumn Header="Name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Padding="3"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Notes (read-only count, drills into the citing notes) -->
                <DataGridTemplateColumn Header="Notes" Width="60" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding NoteCount}"
                                    Padding="10,1" Margin="4,2" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="Open every note citing this Part"
                                    Command="{Binding DataContext.OpenSourceMaterialPartWindowCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Reviewed (orthogonal to Notes — see CLAUDE.md's negative-space 2x2) -->
                <DataGridTemplateColumn Header="Reviewed" Width="70" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsReviewed}" HorizontalAlignment="Center"
                                      ToolTip="Deliberately passed over for TLTT material — independent of whether any note cites it"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Delete -->
                <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DeleteButton}"
                                    ToolTip="Delete Part"
                                    Command="{Binding DataContext.DeletePartCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Save bar ── -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save All" Padding="14,5"
                    Command="{Binding SaveAllCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
