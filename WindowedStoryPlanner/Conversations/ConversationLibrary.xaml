<UserControl x:Class="WindowedStoryPlanner.ConversationLibrary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ConversationLibraryViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- ── Toolbar ── -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Conversations" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Scan Claude Export…"
                    Padding="10,4"
                    Command="{Binding ScanClaudeExportCommand}"
                    ToolTip="Compare a conversations.json export against this project and pick which conversations to export for Cowork"/>
            <Button Content="Import from Folder…"
                    Padding="10,4" Margin="8,0,0,0"
                    Command="{Binding ImportFromFolderCommand}"
                    ToolTip="Select a folder containing NNN_*_content.json + NNN_*_meta.json pairs"/>
            <CheckBox Content="Expand cards"
                      VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding ShowExpandedCards, Mode=TwoWay}"
                      ToolTip="Show each conversation's summary expander open by default"/>

            <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="16,0,6,0" FontSize="12"/>
            <ComboBox VerticalAlignment="Center" MinWidth="150"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SortMode, Mode=TwoWay}"
                      ToolTip="Choose how conversations are ordered">
                <ComboBoxItem Content="Date (oldest first)" Tag="{x:Static local:ConversationSortMode.Date}"/>
                <ComboBoxItem Content="Most left to read"   Tag="{x:Static local:ConversationSortMode.Unread}"/>
            </ComboBox>
        </StackPanel>

        <!-- ── Subject filter ── -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter by subject:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
            <ComboBox ItemsSource="{Binding AllSubjects}"
                      SelectedItem="{Binding SubjectFilter, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      MinWidth="200" VerticalAlignment="Center"
                      ToolTip="Show only conversations covering this subject"/>
            <Button Content="✕" Padding="8,3" Margin="4,0,0,0"
                    Command="{Binding ClearSubjectFilterCommand}"
                    ToolTip="Clear subject filter"
                    Visibility="{Binding SubjectFilter, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ── Dashboard ── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4"
                Background="#F9FAFB" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="#444" Margin="0,0,0,4">
                    <Run Text="{Binding TotalConversations, Mode=OneWay}"/> <Run Text=" conversations — "/>
                    <Run Text="{Binding CompleteCount, Mode=OneWay}"    Foreground="#2AA050"/> <Run Text=" Complete, "/>
                    <Run Text="{Binding InProgressCount, Mode=OneWay}"  Foreground="#E07020"/> <Run Text=" In Progress, "/>
                    <Run Text="{Binding UnstartedCount, Mode=OneWay}"   Foreground="#888"/>    <Run Text=" Unstarted"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#444">
                    <Run Text="{Binding TotalBlocks, Mode=OneWay}"/> <Run Text=" blocks — "/>
                    <Run Text="{Binding TotalDone, Mode=OneWay}"    Foreground="#2AA050"/> <Run Text=" Done, "/>
                    <Run Text="{Binding TotalSkipped, Mode=OneWay}" Foreground="#4A82D2"/> <Run Text=" Skipped, "/>
                    <Run Text="{Binding TotalFlagged, Mode=OneWay}" Foreground="#E07020"/> <Run Text=" Flagged, "/>
                    <Run Text="{Binding TotalUnread, Mode=OneWay}"  Foreground="#888"/>    <Run Text=" Unread"/>
                </TextBlock>

                <!-- ── Overall progress ── -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding OverallProgressFraction, Mode=OneWay}"
                                 Minimum="0" Maximum="1"
                                 Height="10" VerticalAlignment="Center"
                                 Foreground="#2AA050"/>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#2AA050">
                        <Run Text="{Binding OverallProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Search ── -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search: " VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="260" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Conversation card list ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredConversations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ConversationViewModel}">
                        <local:ConversationCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
