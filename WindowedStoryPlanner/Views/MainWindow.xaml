<Window x:Class="WindowedStoryPlanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowedStoryPlanner.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:WindowedStoryPlanner.Views"
        xmlns:m="clr-namespace:StoryPlanner.Core.Models;assembly=StoryPlanner.Core"
        mc:Ignorable="d"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        Title="Mission Control" Height="900" Width="1200"
        WindowStartupLocation="CenterScreen" d:DataContext="{d:DesignInstance Type=vm:ViewModelLocator}" WindowState="Maximized">
    <Window.Resources>
        <v:UtcToLocalConverter x:Key="UtcToLocalConverter" />
        <v:RecencyToColorConverter x:Key="RecencyToColorConverter" />
    </Window.Resources>

    <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">

        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Height" Value="60" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </TabControl.Resources>

        <TabItem Header="File Management">
            <v:FileManagerTab DataContext="{Binding FileManager}"/>
        </TabItem>

        <TabItem Header="Chapters">
            <v:ChapterLibrary DataContext="{Binding Chapters}"/>
        </TabItem>

        <TabItem Header="Unassigned Plot Points" DataContext="{Binding FloatingPlotPoints}">
            <StackPanel Margin="20" MaxWidth="400">
                <TextBlock Text="Unassigned Plot Points"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,16"
                           Text="Plot points not yet assigned to a chapter. Open the window to edit, reorder, or drag them into a chapter."/>
                <Button Content="Open Unassigned Plot Points Window"
                        Height="36" FontSize="14" HorizontalAlignment="Left" Padding="12,0"
                        Command="{Binding OpenWindowCommand}"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Subjects">
            <v:SubjectLibrary DataContext="{Binding Subjects}"/>
        </TabItem>
        <TabItem Header="Themes">
            <v:ThemeLibrary DataContext="{Binding Themes}"/>
        </TabItem>
        <TabItem Header="Definitions">
            <v:DefinitionsEditorControl DataContext="{Binding Definitions}"/>
        </TabItem>

        <TabItem Header="Global Search">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="Search Entities (Characters, Chapters, Threads, etc.)" 
                               FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="20" Padding="5" Height="40" 
                             VerticalContentAlignment="Center"
                             Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </TabItem>

        <TabItem Header="Sources">
            <v:SourceMaterialLibrary DataContext="{Binding SourceMaterials}"/>
        </TabItem>

        <TabItem Header="Conversations">
            <v:ConversationLibrary DataContext="{Binding ConversationLibrary}"/>
        </TabItem>

        <TabItem Header="Export">
            <v:ExportView DataContext="{Binding Export}"/>
        </TabItem>

    </TabControl>
</Window>
