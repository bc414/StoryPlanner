<UserControl x:Class="WindowedStoryPlanner.Views.ConversationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WindowedStoryPlanner.ViewModels"
             xmlns:v="clr-namespace:WindowedStoryPlanner.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConversationViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <v:ConversationDerivedStateToColorConverter  x:Key="StateToColor"/>
        <v:ConversationDerivedStateToLabelConverter  x:Key="StateToLabel"/>
        <v:PlatformToVisibilityConverter             x:Key="PlatformToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,8" Padding="12,10" Background="White"
            Cursor="Hand"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
                Row 0 header strip: Delete (far left) .... Title+badges (fills) .... State badge, Open Reader (far right).
                Delete and Open Reader are deliberately at opposite ends — never adjacent — so a misclick
                between "open" and "destroy" can't happen.
            -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Delete"
                        Padding="6,2" FontSize="11" Margin="10,0,0,0"
                        Foreground="#C0392B"
                        Command="{Binding DataContext.DeleteConversationCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>

                <Button DockPanel.Dock="Left" Content="Open Reader"
                        Padding="6,2" FontSize="11" Margin="0,0,10,0"
                        Command="{Binding DataContext.OpenConversationReaderCommand,
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>

                <Border DockPanel.Dock="Right"
                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                        Background="{Binding DerivedState, Converter={StaticResource StateToColor}}">
                    <TextBlock Text="{Binding DerivedState, Converter={StaticResource StateToLabel}}"
                               FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             MinWidth="120"/>

                    <!-- Claude badge — warm terracotta on cream, serif wordmark echoing Claude.ai's own typography -->
                    <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="#F5E6DE" BorderBrush="#E3C4AC" BorderThickness="1"
                            Visibility="{Binding Platform, Converter={StaticResource PlatformToVis}, ConverterParameter=Claude}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#C15F3C"
                                   FontFamily="Georgia, 'Times New Roman', serif">
                            <Run Text="✳ "/><Run Text="Claude"/>
                        </TextBlock>
                    </Border>

                    <!-- Gemini badge — blue-purple-pink sparkle gradient echoing the Gemini icon -->
                    <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Platform, Converter={StaticResource PlatformToVis}, ConverterParameter=Gemini}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4285F4" Offset="0"/>
                                <GradientStop Color="#9B72CB" Offset="0.5"/>
                                <GradientStop Color="#D96570" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                                   FontFamily="Segoe UI, sans-serif">
                            <Run Text="✦ "/><Run Text="Gemini"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Date + block count -->
            <TextBlock Grid.Row="1"
                       Margin="0,0,0,4" FontSize="12" Foreground="#666">
                <Run Text="{Binding ConversationDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                <Run Text=" · "/>
                <Run Text="{Binding BlockCount, Mode=OneWay}"/>
                <Run Text=" blocks"/>
            </TextBlock>

            <!-- Row 2: Progress bar -->
            <ProgressBar Grid.Row="2"
                         Value="{Binding ProgressFraction, Mode=OneWay}"
                         Minimum="0" Maximum="1"
                         Height="6" Margin="0,0,0,4"
                         Foreground="#2AA050"/>

            <!-- Row 3: Stats line -->
            <TextBlock Grid.Row="3"
                       FontSize="11" Foreground="#888">
                <Run Text="{Binding DoneCount, Mode=OneWay}"/>    <Run Text="Done  "/>
                <Run Text="{Binding SkippedCount, Mode=OneWay}"/> <Run Text="Skipped  "/>
                <Run Text="{Binding FlaggedCount, Mode=OneWay}" Foreground="#E07020"/> <Run Text="Flagged  "/>
                <Run Text="{Binding UnreadCount, Mode=OneWay}"/>  <Run Text="Unread"/>
            </TextBlock>

            <!--
                Row 4: summary expander. IsExpanded follows the library's "Expand cards"
                setting OneWay, so flipping that setting opens/closes every card, while a
                user can still toggle an individual card without disturbing the others.
            -->
            <Expander Grid.Row="4" Margin="0,6,0,0" Header="Summary"
                      FontSize="11" Foreground="#666"
                      IsExpanded="{Binding DataContext.ShowExpandedCards,
                                   RelativeSource={RelativeSource AncestorType=ItemsControl},
                                   Mode=OneWay}">
                <TextBlock Text="{Binding ArcSummary, Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="12" Foreground="#444"
                           Margin="4,4,0,2"/>
            </Expander>

        </Grid>
    </Border>
</UserControl>
