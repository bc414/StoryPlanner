<UserControl x:Class="WindowedStoryPlanner.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WindowedStoryPlanner.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ExportViewModel}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════ LEFT: Anchor Picker + Anchors ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Search controls -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Anchor Search" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="4" Height="32"
                             VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding TypeFilterOptions}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              FontSize="13" Height="32"/>
                    <Button Grid.Column="4"
                            Content="Add →"
                            Height="32" FontSize="13"
                            Command="{Binding AddAnchorCommand}"
                            Background="#2E86C1" Foreground="White" BorderThickness="0"/>
                </Grid>
            </StackPanel>

            <!-- Search results -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedSearchResult}"
                     BorderBrush="#CCCCCC" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="SearchResults_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnchorCandidateItem}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding TypeLabel}" Foreground="#777"
                                       FontSize="11" Width="70" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected anchors header -->
            <TextBlock Grid.Row="3" Text="Selected Anchors"
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>

            <!-- Selected anchors list -->
            <ListBox Grid.Row="4"
                     ItemsSource="{Binding Anchors}"
                     BorderBrush="#CCCCCC" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AnchorCandidateItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TypeLabel}"
                                       Foreground="#777" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                       FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                    Foreground="#CC0000" Background="Transparent"
                                    BorderBrush="#CC0000" Padding="0"
                                    Command="{Binding DataContext.RemoveAnchorCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ════════════════════════════════════════ RIGHT: Export Options ═══════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Scope -->
                <TextBlock Text="Scope" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <ComboBox SelectedIndex="{Binding Scope}" FontSize="13" Margin="0,0,0,16">
                    <ComboBoxItem Content="0 — Anchors only (+ link bonus)"/>
                    <ComboBoxItem Content="1 — + All link tracks"/>
                    <ComboBoxItem Content="2 — + Other-end subject profiles"/>
                </ComboBox>

                <!-- Chapter range -->
                <TextBlock Text="Chapter Range (optional)" FontWeight="Bold"
                           FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="Filters link expansion to chapters within this range."
                           FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="From" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ChapterFromText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="4" Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ChapterToText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="4" Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- Track types -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Track Types"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="All" Padding="6,2" FontSize="11"
                            Command="{Binding SelectAllTrackTypesCommand}"/>
                    <Button Grid.Column="3" Content="None" Padding="6,2" FontSize="11"
                            Command="{Binding SelectNoneTrackTypesCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding TrackTypeFilters}" Margin="0,0,0,20"
                              BorderBrush="#CCCCCC" BorderThickness="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrackTypeFilterItem}">
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsIncluded}"
                                      Margin="6,3" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Full dump / individual export buttons -->
                <Button Content="Export Everything (Full Dump)"
                        Height="36" FontSize="13" FontWeight="SemiBold"
                        Command="{Binding ExportFullCommand}"
                        Background="#1E8449" Foreground="White"
                        BorderThickness="0" Margin="0,0,0,6"/>
                <Button Content="Export All as Individual Files"
                        Height="36" FontSize="13" FontWeight="SemiBold"
                        Command="{Binding ExportIndividualCommand}"
                        Background="#1E8449" Foreground="White"
                        BorderThickness="0" Margin="0,0,0,16"/>

                <!-- Anchor-based export button -->
                <Button Content="Export to Markdown"
                        Height="40" FontSize="15" FontWeight="Bold"
                        Command="{Binding ExportCommand}"
                        Background="#1A5276" Foreground="White"
                        BorderThickness="0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
