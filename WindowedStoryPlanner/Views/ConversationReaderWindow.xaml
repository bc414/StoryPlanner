<Window x:Class="WindowedStoryPlanner.Views.ConversationReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:WindowedStoryPlanner.ViewModels"
        xmlns:v="clr-namespace:WindowedStoryPlanner.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConversationViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Height="840" Width="1440"
        MinHeight="500" MinWidth="900" WindowState="Maximized">

    <!-- F1–F4 set the state of the currently selected block (mirrors the right-click menu order) -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding SetSelectedUnreadCommand}"/>
        <KeyBinding Key="F2" Command="{Binding SetSelectedSkippedCommand}"/>
        <KeyBinding Key="F3" Command="{Binding SetSelectedFlaggedCommand}"/>
        <KeyBinding Key="F4" Command="{Binding SetSelectedDoneCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <v:ConversationDerivedStateToColorConverter  x:Key="StateToColor"/>
        <v:ConversationDerivedStateToLabelConverter  x:Key="StateToLabel"/>
        <v:BlockStateToColorConverter                x:Key="BlockStateToColor"/>
        <v:BlockStateToRowBackgroundConverter        x:Key="BlockStateToRowBackground"/>
        <v:BoolToVisibilityConverter                 x:Key="BoolToVisConverter"/>

        <!-- Block state context menu — DataContext is ConversationBlockViewModel -->
        <ContextMenu x:Key="BlockContextMenu">
            <MenuItem Header="Mark _Unread"  Command="{Binding MarkUnreadCommand}"/>
            <MenuItem Header="Mark _Skipped" Command="{Binding MarkSkippedCommand}"/>
            <MenuItem Header="Mark _Flagged" Command="{Binding MarkFlaggedCommand}"/>
            <MenuItem Header="Mark _Done"    Command="{Binding MarkDoneCommand}"/>
        </ContextMenu>

        <!-- ListBox chrome-free style -->
        <Style x:Key="NakedListBox" TargetType="ListBox">
            <Setter Property="BorderThickness"                            Value="0"/>
            <Setter Property="Background"                                 Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
        </Style>

        <!--
            ListBoxItem background layering (DataContext = ConversationBlockViewModel):
              1. StateLayer   — always shows BlockState as a pale full-row background.
              2. HoverLayer   — semi-transparent white, lightens whatever's underneath on hover.
              3. SelectedLayer — solid selection color, overrides everything when selected
                                 (hides the state tint on the one row you're actively viewing).
        -->
        <Style x:Key="NakedListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Margin"                     Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu"                Value="{StaticResource BlockContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border Background="{Binding BlockState, Converter={StaticResource BlockStateToRowBackground}}"/>
                            <Border x:Name="HoverLayer" Background="White" Opacity="0"/>
                            <Border x:Name="SelectedLayer" Background="#DDE8FF" Opacity="0"/>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedLayer" Property="Opacity" Value="1"/>
                                <Setter TargetName="HoverLayer"    Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- routing header -->
            <RowDefinition Height="*"/>    <!-- three columns -->
        </Grid.RowDefinitions>

        <!-- ══ Arc Summary ══ -->
        <Border Grid.Row="0"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Background="#F8F9FA" Padding="12,8">
            <DockPanel>
                <!-- Snap-to-half buttons — mirrors CommonWindow's pair.
                     Docked first so the summary TextBlock fills what's left;
                     top-aligned so they stay put when a long summary wraps. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button x:Name="SnapTopHalfButton"
                            Content="⬆ Top" Width="50"
                            Style="{StaticResource ModeButtonStyle}"
                            ToolTip="Snap window to top half of screen"
                            Click="SnapTopHalf_Click"/>
                    <Button x:Name="SnapBottomHalfButton"
                            Content="⬇ Bot" Width="50"
                            Style="{StaticResource ModeButtonStyle}"
                            ToolTip="Snap window to bottom half of screen"
                            Click="SnapBottomHalf_Click"/>
                </StackPanel>

                <TextBlock Text="{Binding ArcSummary}"
                           FontSize="13" Foreground="#333"
                           TextWrapping="Wrap"
                           MaxHeight="80"/>
            </DockPanel>
        </Border>

        <!-- ══ Four-column layout ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"  MinWidth="60"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: compact block index ── -->
            <ListBox Grid.Column="0"
                     Style="{StaticResource NakedListBox}"
                     ItemContainerStyle="{StaticResource NakedListBoxItem}"
                     ItemsSource="{Binding Blocks}"
                     SelectedItem="{Binding SelectedBlock, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConversationBlockViewModel}">
                        <StackPanel Margin="5,3,4,3">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#333"
                                       Text="{Binding BlockNumber}"/>
                            <TextBlock FontSize="10" Foreground="#888"
                                       Text="{Binding Speaker}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="★" FontSize="9" Foreground="#D08020"
                                       Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVisConverter}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

            <!-- ── Middle: summary cards ── -->
            <ListBox Grid.Column="2"
                     Style="{StaticResource NakedListBox}"
                     ItemContainerStyle="{StaticResource NakedListBoxItem}"
                     ItemsSource="{Binding Blocks}"
                     SelectedItem="{Binding SelectedBlock, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConversationBlockViewModel}">
                        <Border Padding="8,6" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontSize="11" Foreground="#666">
                                        <Run Text="{Binding BlockNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Speaker, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text=" ★" FontSize="10" Foreground="#D08020"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           FontSize="12" Foreground="#333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

            <!-- ── Right: rendered content ── -->
            <wv2:WebView2 Grid.Column="4" Name="ContentWebView"/>

            <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

            <!-- ── Far right: subject coverage checklist ── -->
            <DockPanel Grid.Column="6" Background="#F8F9FA">
                <TextBlock DockPanel.Dock="Top" Text="Subject Coverage"
                           FontSize="12" FontWeight="SemiBold" Foreground="#444"
                           Margin="8,8,8,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SubjectCoverages}" Margin="8,0,8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SubjectCoverageViewModel}">
                                <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                                        Background="#F0F4FF" BorderBrush="#C6D9FF" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Subject header — pure navigation, no note creation -->
                                        <TextBlock Text="{Binding SubjectName, Mode=OneWay}"
                                                   FontSize="12" Foreground="#1A73E8" FontWeight="SemiBold"
                                                   Cursor="Hand" Margin="0,0,0,4"
                                                   ToolTip="Open subject">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenSubjectCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>

                                        <!-- Tracks — stacked vertically underneath the subject -->
                                        <ItemsControl ItemsSource="{Binding Tracks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CoverageTrackViewModel}">
                                                    <Border CornerRadius="3" Padding="4,2" Margin="0,0,0,2"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                                <Setter Property="ToolTip" Value="Click to create a note in this track"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                        <Setter Property="Background" Value="#DFF3E3"/>
                                                                        <Setter Property="ToolTip" Value="Note already added — click to open"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.AddCoverageTrackCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x2610;" FontSize="11" Margin="0,0,4,0"
                                                                       Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"/>
                                                            <TextBlock Text="&#x2611;" FontSize="11" Margin="0,0,4,0" Foreground="#2AA050"
                                                                       Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding TrackName, Mode=OneWay}"
                                                                       FontSize="11" Foreground="#333" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

        </Grid>
    </Grid>
</Window>
