<Window x:Class="WindowedStoryPlanner.Views.SourceMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowedStoryPlanner.Views"
        xmlns:vm="clr-namespace:WindowedStoryPlanner.ViewModels"
        mc:Ignorable="d"
        Title="{Binding SourceMaterial.Name, StringFormat='Source: {0}'}"
        Height="800" Width="700"
        d:DataContext="{d:DesignInstance Type=vm:SourceMaterialDetailViewModel}">

    <Window.Resources>
        <local:NoteBreadcrumbConverter x:Key="NoteBreadcrumbConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ── Source material header ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Name" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
            <TextBox Text="{Binding SourceMaterial.Name, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18" FontWeight="Bold"
                     BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

            <TextBlock Text="Description" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
            <TextBox Text="{Binding SourceMaterial.Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     BorderThickness="0,0,0,1" Padding="0,0,0,4"/>
        </StackPanel>

        <!-- ── Tagged notes ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock FontSize="11" FontStyle="Italic" Foreground="#888888" Margin="2,0,0,2">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource NoteBreadcrumbConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext"
                                                 RelativeSource="{RelativeSource AncestorType=local:SourceMaterialWindow}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <local:NoteView/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
