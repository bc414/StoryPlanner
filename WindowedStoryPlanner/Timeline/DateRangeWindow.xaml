<Window x:Class="WindowedStoryPlanner.DateRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowedStoryPlanner"
        mc:Ignorable="d"
        Title="World date range"
        Height="900" Width="760"
        d:DataContext="{d:DesignInstance Type=local:DateRangeNotesViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ── Range criterion ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Range" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" FontSize="15" Padding="4,3">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ApplyRangeCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Apply" Padding="14,4" Margin="8,0,0,0"
                        Command="{Binding ApplyRangeCommand}"/>
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center"
                           Margin="14,0,0,0" Foreground="#666666"/>
            </StackPanel>

            <TextBlock Text="{Binding RangeError}" Foreground="#CC0000" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasRangeError, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="A year (1007), an interval (854..914), or an open end (854.. / ..914). Negative years are BLB; 0 is the banishment. Event notes only — conditions in force over a span belong to the timeline canvas."
                       FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Plot points: the syuzhet register, kept separate from the notes above ── -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Padding="0,8,0,0" MaxHeight="260"
                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Plot points in this range" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Scenes, not notes — a plot point carries a fabula date and no notes of its own. Rebuilt when the range is applied."
                               FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyPlotPointsText}"
                           FontStyle="Italic" Foreground="#888888" Margin="2,4,0,0"
                           Visibility="{Binding HasPlotPoints, Converter={StaticResource NotBoolToVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlotPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Italic + story-colour edge: the same signal the timeline
                                     legend uses for a plot point, so the two registers read as
                                     different kinds at a glance. -->
                                <Border BorderBrush="#C53B3B" BorderThickness="3,0,0,0"
                                        Padding="7,3" Margin="0,0,0,3" Background="#FAFAFA">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DateText}" FontFamily="Consolas"
                                                   Foreground="#555555" Width="96"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontStyle="Italic"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="300"/>
                                        <TextBlock Text="{Binding ChapterText}" Foreground="#888888"
                                                   FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"/>
                                        <TextBlock Text="{Binding TheaterText}" Foreground="#888888"
                                                   FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="Open" Padding="6,1" Margin="10,0,0,0"
                                                Command="{Binding OpenCommand}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Dated notes: the shared cross-cut list ── -->
        <Grid>
            <local:CrossCutNoteListView/>
            <TextBlock Text="{Binding EmptyNotesText}" FontStyle="Italic" Foreground="#888888"
                       Margin="2,4,0,0" VerticalAlignment="Top"
                       Visibility="{Binding HasNotes, Converter={StaticResource NotBoolToVis}}"/>
        </Grid>

    </DockPanel>
</Window>
