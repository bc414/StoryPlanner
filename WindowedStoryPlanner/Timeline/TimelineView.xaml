<UserControl x:Class="WindowedStoryPlanner.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=local:TimelineViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- One note in full. Shared by the hover popup and pinned cards so they can never
             drift apart. Flag reason gets its own tinted box, matching NoteView. -->
        <DataTemplate x:Key="NoteCardTemplate" DataType="{x:Type local:NoteCard}">
            <Border BorderBrush="#EDEDED" BorderThickness="0,0,0,1" Padding="0,5">
                <DockPanel>
                    <Rectangle Width="3" DockPanel.Dock="Left" Margin="0,2,7,2" VerticalAlignment="Stretch">
                        <Rectangle.Fill><SolidColorBrush Color="{Binding Fill}"/></Rectangle.Fill>
                    </Rectangle>
                    <StackPanel>
                        <!-- Suppressed when the card's title already names this note (a condition
                             bar or a placed marker) — otherwise the subject would appear twice. -->
                        <StackPanel Visibility="{Binding DataContext.ShowNoteHeaders,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                    Converter={StaticResource BoolToVis}}">
                            <TextBlock FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Subject}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                <Setter Property="Text" Value="{Binding Subject, StringFormat=⚑ {0}}"/>
                                                <Setter Property="Foreground" Value="#9C3B2E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlotPoint}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="#999" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" FontSize="12" Margin="0,2,0,0"
                                 Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}"/>
                        <!-- Date row: the knob is a drag source for re-dating (drop anywhere on
                             the canvas), and ▾ opens the full year/month/day picker. Both write
                             through the note's own validated setter and then save. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding CanEditDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⠿" FontSize="12" Foreground="#AAA" Cursor="SizeAll"
                                       VerticalAlignment="Center" Margin="0,0,5,0" Padding="2,0"
                                       ToolTip="Drag onto the timeline to re-date this note"
                                       PreviewMouseLeftButtonDown="CardKnob_DragStart"
                                       PreviewMouseMove="CardKnob_DragMove"/>
                            <TextBlock Text="date" FontSize="10" Foreground="#AAA"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding Editable.WorldDate, UpdateSourceTrigger=LostFocus}"
                                     MinWidth="86" FontSize="11" VerticalAlignment="Center"
                                     ToolTip="{Binding Editable.WorldDateHint}"
                                     LostFocus="CardDate_LostFocus"/>
                            <local:WorldDatePickerControl VerticalAlignment="Center" Margin="2,0,0,0"
                                                          Note="{Binding Editable}"
                                                          SaveCommand="{Binding SaveCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Editable.WorldDateError}" Foreground="#CC4444" FontSize="10"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Editable.HasWorldDateError, Converter={StaticResource BoolToVis}}"/>

                        <Border Visibility="{Binding HasFlagReason, Converter={StaticResource BoolToVis}}"
                                Background="#FDF6F4" BorderBrush="#F0D9D2" BorderThickness="1"
                                CornerRadius="3" Padding="6" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="flag reason" FontSize="10" Foreground="#9C3B2E" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding FlagReason, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The card body: title, subtitle, and every note in full, scrollable. -->
        <!-- The Title is NOT rendered here: the pinned card's drag header and the popup's own
             header each carry it, so repeating it in the body would state it twice. -->
        <DataTemplate x:Key="CardContentTemplate" DataType="{x:Type local:CardContent}">
            <StackPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Margin="0,0,0,3"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteCardTemplate}"/>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>

        <!-- Theater column: alternating neutral band + name. Identity comes from position and
             header text, never a hue — hue belongs to subject type + plot points. -->
        <!-- The column's background band, in the scrolling body -->
        <DataTemplate DataType="{x:Type local:TheaterColumnItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="#D8D8D8" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBandShaded}" Value="True">
                                <Setter Property="Background" Value="#F5F4F1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- Pinned year number in the left gutter -->
        <DataTemplate DataType="{x:Type local:YearLabelItem}">
            <TextBlock Width="{Binding Width}" Height="{Binding Height}" Text="{Binding Label}"
                       TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding Tooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Foreground" Value="#999"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPivot}" Value="True">
                                <Setter Property="Foreground" Value="#B0413E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TheaterHeaderItem}">
            <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}">
                <Border BorderBrush="#D8D8D8" BorderThickness="1,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FAFAF8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBandShaded}" Value="True">
                                    <Setter Property="Background" Value="#F1EFEA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- Expanded: horizontal name. Click to collapse. -->
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Cursor="Hand"
                           Margin="10,6,0,0" VerticalAlignment="Top" Foreground="#333"
                           Visibility="{Binding IsCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ToggleTheaterCollapseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding TheaterId}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <!-- Collapsed: rotated name + item count, full-height click target to expand -->
                <Border Background="Transparent" Cursor="Hand"
                        Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ToggleTheaterCollapseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding TheaterId}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShortName}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#555" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CountLabel}" FontSize="9" Foreground="#AAA"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Collapsed column's density ribbon: one tick per populated year -->
        <DataTemplate DataType="{x:Type local:DensityTickItem}">
            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#7A7A7A"
                       Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}"/>
        </DataTemplate>

        <!-- A collapsed era's summary band: compression is explicit and labelled, never silent -->
        <DataTemplate DataType="{x:Type local:EraBandItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}" Background="#EFEAE2"
                    BorderBrush="#D6CCBC" BorderThickness="0,1,0,1" ToolTip="{Binding Tooltip}">
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#8A7A62"
                           Margin="56,0,0,0" VerticalAlignment="Center" FontStyle="Italic"/>
            </Border>
        </DataTemplate>

        <!-- Condition bar: height IS extent — the one mark whose size means duration. -->
        <DataTemplate DataType="{x:Type local:ConditionBarItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand"
                    CornerRadius="3" ToolTip="{Binding Tooltip}"
                    MouseEnter="Mark_MouseEnter" MouseLeave="Mark_MouseLeave"
                    MouseLeftButtonUp="Mark_Click">
                <Border.Background>
                    <SolidColorBrush Color="{Binding Fill}" Opacity="0.75"/>
                </Border.Background>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                <Setter Property="BorderBrush" Value="#D9822B"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <!-- End TBD: solid start fading downward — in force, terminus unknown -->
                            <DataTrigger Binding="{Binding IsOpenEnded}" Value="True">
                                <Setter Property="OpacityMask">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF000000" Offset="0"/>
                                            <GradientStop Color="#FF000000" Offset="0.15"/>
                                            <GradientStop Color="#28000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" Margin="2,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsLabelVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- Event marker: FIXED size at every zoom — it asserts position, not extent. -->
        <DataTemplate DataType="{x:Type local:EventMarkerItem}">
            <StackPanel Orientation="Horizontal" Width="{Binding Width}" Height="{Binding Height}"
                        Background="Transparent" ToolTip="{Binding Tooltip}" Cursor="Hand"
                        MouseEnter="Mark_MouseEnter" MouseLeave="Mark_MouseLeave"
                        MouseLeftButtonUp="Mark_Click">
                <Rectangle Width="10" Height="10" Margin="0,2,4,0" StrokeThickness="2"
                           Stroke="{Binding Border}">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Fill}"/>
                    </Rectangle.Fill>
                    <Rectangle.LayoutTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.LayoutTransform>
                </Rectangle>
                <TextBlock FontSize="11" Foreground="#333" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="130">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Label}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                    <Setter Property="Text" Value="{Binding Label, StringFormat=⚑ {0}}"/>
                                    <Setter Property="Foreground" Value="#9C3B2E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlotPoint}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:EventWhiskerItem}">
            <Rectangle Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding Fill}" Opacity="0.5"/>
                </Rectangle.Fill>
            </Rectangle>
        </DataTemplate>

        <!-- THE CELL — one (theater, year). While year is the working precision this is the
             primary object, not a fallback: everything inside genuinely shares a year, so no
             order is known or implied. The composition bar shows the subject-type mix; click
             opens the full unordered list in the panel. -->
        <DataTemplate DataType="{x:Type local:EventGlyphItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="4" Cursor="Hand"
                    Background="#FFFFFF" BorderThickness="1.2"
                    MouseEnter="Mark_MouseEnter" MouseLeave="Mark_MouseLeave"
                    MouseLeftButtonUp="Mark_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#8A8A8A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFlagged}" Value="True">
                                <Setter Property="BorderBrush" Value="#D9822B"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F6FC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding YearLabel}" FontSize="9" Foreground="#999"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="#333"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- subject-type composition of the cell -->
                        <ItemsControl ItemsSource="{Binding Composition}" Margin="0,1,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="{Binding Width}" Height="3">
                                        <Rectangle.Fill><SolidColorBrush Color="{Binding Fill}"/></Rectangle.Fill>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Year-view register for conditions: what is IN FORCE during this year band. -->
        <DataTemplate DataType="{x:Type local:ConditionStripItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="3"
                    Background="#EEEDEA" BorderBrush="#CCC9C4" BorderThickness="1"
                    ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="30000">
                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#555" Margin="5,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>

        <!-- Rules span every column; their year numbers live in the pinned gutter instead. -->
        <DataTemplate DataType="{x:Type local:PivotLineItem}">
            <Grid Width="{Binding Width}" ToolTip="{Binding Tooltip}">
                <Rectangle Height="2" Fill="#B0413E" Opacity="0.55" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="#B0413E"
                           Margin="6,2,0,0" HorizontalAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:YearTickItem}">
            <Rectangle Width="{Binding Width}" Height="1" Fill="#E4E2DE" VerticalAlignment="Top"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <!-- Interactive hover popup: opens on a mark, and STAYS while the cursor is inside it, so
         long notes can be scrolled, selected, and copied. StaysOpen=True with manual
         enter/leave tracking in code-behind — a ToolTip cannot do any of that. -->
    <Popup x:Name="HoverPopup" Placement="MousePoint" HorizontalOffset="14" VerticalOffset="10"
           AllowsTransparency="True" StaysOpen="True" Panel.ZIndex="100">
        <Border x:Name="HoverPopupBorder" Width="360" Background="White" BorderBrush="#B4B0A8"
                BorderThickness="1" CornerRadius="5" Padding="12"
                MouseEnter="HoverPopup_MouseEnter" MouseLeave="HoverPopup_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
            <DockPanel>
                <!-- The popup's own header: the title lives here, not in the shared body
                     template, so the pinned card's drag header can carry it instead. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="📌 pin" VerticalAlignment="Top"
                            FontSize="11" Padding="7,2" Margin="8,0,0,0"
                            ToolTip="Freeze this card here and drag it anywhere (clicking the mark itself does the same) — pin a second to compare"
                            Click="PinPopup_Click"/>
                    <TextBlock Text="{Binding ElementName=HoverPopupBorder, Path=Tag.Title}"
                               FontWeight="Bold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <ContentControl Content="{Binding ElementName=HoverPopupBorder, Path=Tag}"
                                ContentTemplate="{StaticResource CardContentTemplate}"/>
            </DockPanel>
        </Border>
    </Popup>

    <!-- Drop confirmation. A drag only ever PROPOSES: this pre-fills from where you released,
         and nothing is written until Confirm. There is no undo in this app, so no gesture may
         change data on its own. -->
    <Popup x:Name="DropConfirmPopup" Placement="MousePoint" HorizontalOffset="16" VerticalOffset="12"
           AllowsTransparency="True" StaysOpen="True" Panel.ZIndex="120"
           IsOpen="{Binding HasPendingAssignment, Mode=OneWay}">
        <Border Width="330" Background="White" BorderBrush="#2E7D32" BorderThickness="1.5"
                CornerRadius="5" Padding="12" DataContext="{Binding PendingAssignment}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding Display}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Context}" FontSize="11" Foreground="#2E7D32" Margin="0,1,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="110" FontSize="12.5" VerticalAlignment="Center"
                             ToolTip="{Binding Hint}"/>
                    <local:WorldDatePickerControl VerticalAlignment="Center" Margin="3,0,0,0"
                                                  Note="{Binding Note}"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding TheaterChoices}" SelectedItem="{Binding SelectedTheater}"
                          DisplayMemberPath="Name" FontSize="12" Margin="0,6,0,0"
                          Visibility="{Binding IsPlotPoint, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Error}" Foreground="#CC4444" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,3" FontSize="12"/>
                    <Button Content="Confirm" Command="{Binding ConfirmCommand}" Padding="12,3"
                            FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,12,0"
                            ToolTip="The timeline is a snapshot — edits made elsewhere appear on Refresh."/>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Width="28" FontSize="14"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Width="28" FontSize="14" Margin="4,0,8,0"
                            ToolTip="Ctrl+mouse wheel also zooms. Zoom reveals resolution you have; it cannot reveal resolution you don't."/>
                    <!-- Shortcuts to either side of the zoom-coupled mode flip -->
                    <Button Content="Unpin all" Command="{Binding CloseAllPinnedCardsCommand}" Padding="8,2" FontSize="12"
                            Margin="0,0,8,0" ToolTip="Close every pinned card"
                            Visibility="{Binding HasPinnedCards, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Survey" Command="{Binding ZoomSurveyCommand}" Padding="8,2" FontSize="12"
                            ToolTip="Jump to survey mode: condition bars whose height is duration, centuries in view."/>
                    <Button Content="Year view" Command="{Binding ZoomYearViewCommand}" Padding="8,2" FontSize="12" Margin="4,0,8,0"
                            ToolTip="Jump past the flip: per-year 'in force' strips for conditions, events placed within the year (needs month/day precision on the note)."/>
                    <Button Content="Date range…" Command="{Binding OpenDateRangeCommand}" Padding="8,2" FontSize="12" Margin="0,0,12,0"
                            ToolTip="Open the dated notes and plot points of a world-date range as a chronological list."/>
                    <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                </StackPanel>
                <!-- Legend: the seven hues. Theater identity is never a hue. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <StackPanel.Resources>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Margin" Value="10,0,3,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </StackPanel.Resources>
                    <Rectangle Fill="#3B6EC5"/><TextBlock Text="Character"/>
                    <Rectangle Fill="#C55BA8"/><TextBlock Text="Bond"/>
                    <Rectangle Fill="#3F9D53"/><TextBlock Text="Organization"/>
                    <Rectangle Fill="#7E57C2"/><TextBlock Text="Civ System"/>
                    <Rectangle Fill="#E08A2E"/><TextBlock Text="Technology"/>
                    <Rectangle Fill="#1FA0A8"/><TextBlock Text="World Law"/>
                    <Rectangle Fill="#C53B3B"/><TextBlock Text="Plot Point (italic, story-color edge)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right side panel: detail + triage + placement + theaters + pivots -->
        <Border DockPanel.Dock="Right" Width="400" BorderBrush="#DDD" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <Expander Header="Selected item" IsExpanded="True">
                        <StackPanel Margin="4">
                            <!-- Expanded CELL: the unordered set that shares a year. Presentation
                                 order is stable but means nothing — anything reading as sequence
                                 would be inventing information the data doesn't have. -->
                            <StackPanel Visibility="{Binding HasSelectedCell, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedCellHeader}" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedCellEntries}" MaxHeight="300">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="3" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                    BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectCellEntryCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <Rectangle Width="4" Height="20" DockPanel.Dock="Left" Margin="0,0,6,0">
                                                        <Rectangle.Fill><SolidColorBrush Color="{Binding Fill}"/></Rectangle.Fill>
                                                    </Rectangle>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Label}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                                            <Setter Property="Text" Value="{Binding Label, StringFormat=⚑ {0}}"/>
                                                                            <Setter Property="Foreground" Value="#9C3B2E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPlotPoint}" Value="True">
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#999"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding SelectedBody, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     MaxHeight="260" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Eras — collapse sparse ranges" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <TextBlock Text="Derived as the gaps between pivots. Collapsing compresses a range to a labelled band — explicit, never silent, and reversible."
                                       FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding EraRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Width="76" FontSize="11" Padding="4,2"
                                                    Command="{Binding DataContext.ToggleEraCollapseCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Collapse"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Content" Value="Expand"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="{Binding Span}" DockPanel.Dock="Right" FontSize="10"
                                                       Foreground="#999" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,10,0,0">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Triage — undated ("/><Run Text="{Binding TriageRows.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding TriageRows}" Margin="4" MaxHeight="500"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#888"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="16"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="⠿" FontSize="12" Foreground="#AAA" Cursor="SizeAll"
                                                           VerticalAlignment="Center" Margin="0,0,5,0" Padding="2,0"
                                                           ToolTip="Drag onto the timeline to propose a date"
                                                           PreviewMouseLeftButtonDown="TriageKnob_DragStart"
                                                           PreviewMouseMove="TriageKnob_DragMove"/>
                                                <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="90" FontSize="12" VerticalAlignment="Center"
                                                         ToolTip="{Binding DateHint}"/>
                                                <ComboBox ItemsSource="{Binding TheaterChoices}"
                                                          SelectedItem="{Binding SelectedTheater}"
                                                          DisplayMemberPath="Name" MinWidth="110" FontSize="12" Margin="6,0,0,0"
                                                          Visibility="{Binding IsPlotPoint, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Assign" Command="{Binding AssignCommand}"
                                                        Margin="6,0,0,0" Padding="8,2" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Error}" Foreground="#CC4444" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Margin="0,10,0,0">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Subject placement ("/><Run Text="{Binding SubjectPlacementRows.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding SubjectPlacementRows}" Margin="4" MaxHeight="500"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="10" Foreground="#999"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TheaterChoices}"
                                                  SelectedItem="{Binding SelectedTheater}"
                                                  DisplayMemberPath="Name" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="Theaters" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <TextBlock Text="Columns, in narrative-density order — a display coordinate, not a taxonomy. Order is only a starting default: reorder here, or click a column header on the canvas to collapse it."
                                       FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding TheaterRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="✕" Width="22" FontSize="10" Foreground="#CC4444"
                                                    ToolTip="Delete — members return to (Unplaced), nothing is cascaded"
                                                    Command="{Binding DataContext.DeleteTheaterCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="▼" Width="22" FontSize="8"
                                                    Command="{Binding DataContext.MoveTheaterDownCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="▲" Width="22" FontSize="8"
                                                    Command="{Binding DataContext.MoveTheaterUpCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- A plain Button, not a ToggleButton: the content already
                                                 carries the state, and ToggleButton's IsChecked would be a
                                                 second source of truth fighting the OneWay binding. -->
                                            <Button DockPanel.Dock="Right" Width="26" FontSize="9" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleTheaterCollapseCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding TheaterId}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="◧"/>
                                                        <Setter Property="ToolTip" Value="Collapse this column on the canvas"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Content" Value="▣"/>
                                                                <Setter Property="ToolTip" Value="Expand this column"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBox Text="{Binding Name}" FontSize="12" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add theater" Command="{Binding AddTheaterCommand}" Padding="8,2" FontSize="12"/>
                                <Button Content="Expand all" Command="{Binding ExpandAllTheatersCommand}" Padding="8,2" FontSize="12" Margin="6,0,0,0"/>
                                <Button Content="Save name edits" Command="{Binding SaveEditsCommand}" Padding="8,2" FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Pivots" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <TextBlock Text="World-wide causal regime changes; eras are the gaps between them. Never per-theater."
                                       FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding PivotRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="✕" Width="22" FontSize="10" Foreground="#CC4444"
                                                    ToolTip="Delete — eras re-derive from the pivots that remain"
                                                    Command="{Binding DataContext.DeletePivotCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBox DockPanel.Dock="Left" Text="{Binding Year}" Width="52" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBox Text="{Binding Name}" FontSize="12"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox Text="{Binding NewPivotYearText, UpdateSourceTrigger=PropertyChanged}" Width="52" FontSize="12" ToolTip="Year (negative = BLB)"/>
                                <TextBox Text="{Binding NewPivotName, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="12" Margin="6,0" ToolTip="Name"/>
                                <Button Content="Add pivot" Command="{Binding AddPivotCommand}" Padding="8,2" FontSize="12"/>
                            </StackPanel>
                            <Button Content="Save edits" Command="{Binding SaveEditsCommand}" Padding="8,2" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Four panes, Excel freeze-panes style: the theater headers never scroll vertically,
             the year gutter never scrolls horizontally, and both stay synced to the body. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Corner: fixed, above the gutter and left of the headers -->
            <Border Grid.Row="0" Grid.Column="0" Width="{Binding GutterWidth}" Height="{Binding HeaderHeight}"
                    Background="#FAFAF8" BorderBrush="#D8D8D8" BorderThickness="0,0,1,1"/>

            <!-- Pinned theater headers: horizontal scroll synced from the body -->
            <ScrollViewer x:Name="HeaderScroller" Grid.Row="0" Grid.Column="1"
                          Height="{Binding HeaderHeight}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Background="#FAFAF8">
                <ItemsControl ItemsSource="{Binding HeaderItems}"
                              Width="{Binding CanvasWidth}" Height="{Binding HeaderHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pinned year gutter: vertical scroll synced from the body -->
            <ScrollViewer x:Name="GutterScroller" Grid.Row="1" Grid.Column="0"
                          Width="{Binding GutterWidth}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                          Background="#FAFAF8">
                <Border BorderBrush="#D8D8D8" BorderThickness="0,0,1,0">
                    <ItemsControl ItemsSource="{Binding GutterItems}"
                                  Width="{Binding GutterWidth}" Height="{Binding CanvasHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Border>
            </ScrollViewer>

            <!-- Pinned cards float above every pane so two notes from different theatres and
                 years can be dragged side by side. The Canvas has no background, so hit-testing
                 falls through to the timeline everywhere except on a card itself. -->
            <ItemsControl x:Name="PinnedLayer" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                          ItemsSource="{Binding PinnedCards}" Panel.ZIndex="50">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas Background="{x:Null}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Same width as the hover popup so pinning never resizes the card -->
                        <Border Width="360" Background="White" BorderBrush="#B4B0A8" BorderThickness="1"
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.28"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Drag handle -->
                                <Border Background="#F2F0EC" CornerRadius="4,4,0,0" Padding="8,5"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="PinnedCard_DragStart"
                                        MouseMove="PinnedCard_Drag"
                                        MouseLeftButtonUp="PinnedCard_DragEnd">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Width="18" Height="18" Padding="0"
                                                FontSize="10" Foreground="#996" Background="Transparent"
                                                BorderThickness="0" ToolTip="Close this card"
                                                Command="{Binding DataContext.ClosePinnedCardCommand, RelativeSource={RelativeSource AncestorType=local:TimelineView}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="⠿" FontSize="11" Foreground="#AAA" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Content.Title}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <ContentControl Content="{Binding Content}"
                                                ContentTemplate="{StaticResource CardContentTemplate}"
                                                Margin="10,8,10,10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drag ghost: what the date WOULD be if released here. Never writes anything. -->
            <Canvas x:Name="GhostLayer" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{x:Null}" IsHitTestVisible="False" Panel.ZIndex="40"
                    Visibility="{Binding IsDragPreviewVisible, Converter={StaticResource BoolToVis}}">
                <Rectangle Canvas.Left="0" Canvas.Top="{Binding DragPreviewLineY}"
                           Width="{Binding ActualWidth, ElementName=GhostLayer}" Height="1.5"
                           Fill="#2E7D32" Opacity="0.7"/>
                <Border Canvas.Left="{Binding DragPreviewX}" Canvas.Top="{Binding DragPreviewY}"
                        Background="#2E7D32" CornerRadius="3" Padding="7,3">
                    <TextBlock Text="{Binding DragPreviewLabel}" Foreground="White" FontSize="11.5"
                               FontWeight="SemiBold"/>
                </Border>
            </Canvas>

            <!-- The body: scrolls both ways and drives the other two -->
            <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          AllowDrop="True" DragOver="Canvas_DragOver" DragLeave="Canvas_DragLeave"
                          Drop="Canvas_Drop"
                          PreviewMouseWheel="CanvasScroller_PreviewMouseWheel"
                          ScrollChanged="CanvasScroller_ScrollChanged">
                <ItemsControl x:Name="BodyItems" ItemsSource="{Binding Items}"
                              Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    </Grid>
</UserControl>
