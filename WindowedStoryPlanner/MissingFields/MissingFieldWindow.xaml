<Window x:Class="WindowedStoryPlanner.MissingFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowedStoryPlanner"
        mc:Ignorable="d"
        Title="Notes with an empty field"
        Height="850" Width="740"
        d:DataContext="{d:DesignInstance Type=local:MissingFieldNotesViewModel}">

    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ── Criterion ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Field" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Source material" GroupName="Field" VerticalAlignment="Center"
                             IsChecked="{Binding IsSourceSelected, Mode=TwoWay}"/>
                <RadioButton Content="Theme" GroupName="Field" VerticalAlignment="Center" Margin="14,0,0,0"
                             IsChecked="{Binding IsThemeSelected, Mode=TwoWay}"/>
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center"
                           Margin="18,0,0,0" Foreground="#666666"/>
            </StackPanel>
            <TextBlock Text="Which fields a note can carry is set per track. A note leaves this list as soon as you fill the field in below."
                       FontSize="11" Foreground="#999999" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ── The shared cross-cut list ── -->
        <Grid>
            <local:CrossCutNoteListView/>
            <TextBlock Text="{Binding EmptyText}" FontStyle="Italic" Foreground="#888888"
                       Margin="2,4,0,0" VerticalAlignment="Top"
                       Visibility="{Binding HasNotes, Converter={StaticResource NotBoolToVis}}"/>
        </Grid>

    </DockPanel>
</Window>
