<UserControl x:Class="WindowedStoryPlanner.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <local:ColorHexToFillBrushConverter x:Key="HexToFill"/>
    </UserControl.Resources>

    <!-- The whole control is the collapsed face: the same swatch + hex the grids showed before,
         now a button that opens ColorPickerWindow. -->
    <Button Click="Open_Click" Padding="4,1" Background="Transparent" BorderThickness="0"
            HorizontalContentAlignment="Left" Cursor="Hand"
            ToolTip="Pick a colour. No colour is a legal, unfinished state — nothing assigns one.">
        <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="14" BorderBrush="#999999" BorderThickness="1" Margin="0,0,6,0"
                    Background="{Binding Target.ColorHex, ElementName=Root, Converter={StaticResource HexToFill}}"/>
            <TextBlock Text="{Binding Target.ColorHex, ElementName=Root}" VerticalAlignment="Center"/>
            <TextBlock Text=" …" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
