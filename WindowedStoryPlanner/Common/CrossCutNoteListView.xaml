<UserControl x:Class="WindowedStoryPlanner.CrossCutNoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WindowedStoryPlanner"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:TaggedNotesViewModelBase}">

    <!-- The one cross-cutting note list: every note carrying some tag, shown with where it
         actually lives. Hosted by ThemeWindow, SourceMaterialWindow, SourceMaterialPartWindow
         and DateRangeWindow — the breadcrumb binding resolves against THIS control, so a new
         host needs no XAML of its own. -->

    <UserControl.Resources>
        <local:NoteBreadcrumbConverter x:Key="NoteBreadcrumbConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding NotesSource}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <!-- The breadcrumb is the way back: it already names where the note
                             lives, so it is also the control that opens it there. A Button
                             rather than a Hyperlink so the breadcrumb's MultiBinding stays on a
                             plain TextBlock — bindings on a Run inside a Hyperlink resolve
                             through the inline tree and fail quietly when they don't. -->
                        <Button HorizontalAlignment="Left" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="2,0,0,2"
                                ToolTip="Open this note where it lives"
                                Command="{Binding DataContext.OpenOwnerCommand,
                                          RelativeSource={RelativeSource AncestorType=local:CrossCutNoteListView}}"
                                CommandParameter="{Binding}">
                            <TextBlock FontSize="11" FontStyle="Italic"
                                       Foreground="#4A6FA5" TextDecorations="Underline">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource NoteBreadcrumbConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext"
                                                 RelativeSource="{RelativeSource AncestorType=local:CrossCutNoteListView}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <local:NoteView/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
